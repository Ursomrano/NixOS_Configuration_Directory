  fileSystems."/" =
    { device = "/dev/disk/by-uuid/39b87e89-b824-4d58-bdaa-2ec6e6a868c4";
      fsType = "btrfs";
      options = [ "subvol=@" "compress=zstd:1" ];
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/6213-542D";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

  swapDevices = [ ];

  # Enables DHCP on each interface; recommended for scripted networking. With systemd-networkd,
  # also declare `networking.interfaces.<interface>.useDHCP` explicitly.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlp0s20f3.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
