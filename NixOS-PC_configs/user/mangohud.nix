{ config, pkgs, lib, ... }:

let
  user = "ursomrano71";
in
{
  options = {
    mangohud.enableUserConfig = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Whether to deploy the declarative MangoHud.conf for the user";
    };
  };

  config = lib.mkIf config.mangohud.enableUserConfig { 
    # Deploy the full hyprland.conf
    home-manager.users.${user}.home.file = {
    ".config/MangoHud/MangoHud.conf".text = ''
################### File Generated by Goverlay And Ursomrano71###################
legacy_layout=false

background_alpha=0.6
round_corners=10
background_alpha=0.6
background_color=000000

font_size=24
font_size_secondary=100
no_small_font
text_color=FFFFFF
position=top-left
width=250

hud_compact
pci_dev=0:01:00.0
table_columns=3

time#
time_format=%I:%M %P

cpu_text=CPU
cpu_stats
cpu_load_change
cpu_load_value=50,90
cpu_load_color=FFFFFF,FFAA7F,CC0000
cpu_temp
cpu_color=FF8C00

gpu_text=GPU
gpu_stats
gpu_load_change
gpu_load_value=50,90
gpu_load_color=FFFFFF,FFAA7F,CC0000
gpu_temp
gpu_color=91e600

vram
vram_color=518000

ram
ram_color=e9e600

frametime=0
fps
fps_limit_method=late
toggle_fps_limit=Shift_L+F1
fps_limit=280
fps_color_change
fps_color=B22222,FDFD09,39F900
fps_value=57,60

output_folder=/home/ursomrano71
log_duration=30
autostart_log=0
log_interval=100
toggle_logging=Shift_L+F2

blacklist=pamac-manager,lact,ghb,bitwig-studio,ptyxis,yumex
    '';
    ".config/MangoHud/MangoHud.conf".force = true;
    };
  };
}
